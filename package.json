{
  "name": "smartcarehub",
  "version": "1.0.0",
  "description": "SmartCareHub Backend",
  "main": "index.js",
  "scripts": {
    "start": "npm run dev",
    "start:auth": "cd backend/auth-service && node src/server.js",
    "start:patient": "cd backend/patient-service && node server.js",
    "start:appointment": "cd backend/appointment-service && node server.js",
    "start:doctor": "cd backend/doctor-service && node src/server.js",
    "start:notification": "cd backend/notification-service && node src/server.js",
    "start:telemedicine": "cd backend/telemedicine-service && node src/server.js",
    "start:symptom": "cd backend/ai-symptom-service && node src/server.js",
    "start:payment": "cd backend/payment-service && node server.js",
    "start:gateway": "cd backend/api-gateway && node server.js",
    "start:frontend": "cd frontend && npm run dev",
    "dev": "concurrently --kill-others-on-fail --prefix \"[{name}]\" --names \"auth,patient,appt,doctor,notif,telemed,symptom,payment,gateway,frontend\" \"npm run start:auth\" \"npm run start:patient\" \"npm run start:appointment\" \"npm run start:doctor\" \"npm run start:notification\" \"npm run start:telemedicine\" \"npm run start:symptom\" \"npm run start:payment\" \"npm run start:gateway\" \"npm run start:frontend\"",
    "dev:auth": "npm --prefix backend/auth-service run start",
    "dev:patient": "npm --prefix backend/patient-service run dev"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.14"
  },
  "dependencies": {
    "express": "^5.2.1",
    "mongoose": "^9.3.3",
    "react-router-dom": "^7.14.2"
  }
}
